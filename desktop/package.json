{
  "name": "uplog",
  "productName": "UpLog",
  "version": "0.1.0",
  "private": true,
  "description": "UpLog 맥 앱: 로컬 엔진(Java)과 화면을 띄우는 Electron 껍데기",
  "author": "uplog",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "runtime": "scripts/build-runtime.sh",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --arm64 --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "dev.uplog.app",
    "productName": "UpLog",
    "artifactName": "UpLog-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-app",
      "buildResources": "../branding"
    },
    "files": [
      "dist/**/*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      },
      {
        "from": "build/engine.jar",
        "to": "engine.jar"
      },
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "../branding",
        "to": "branding",
        "filter": [
          "trayTemplate.png",
          "trayTemplate@2x.png"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "../branding/UpLog.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSHumanReadableCopyright": "UpLog"
      }
    },
    "dmg": {
      "title": "UpLog ${version}",
      "icon": "../branding/UpLog.icns"
    },
    "electronLanguages": [
      "ko",
      "en"
    ],
    "protocols": [
      {
        "name": "UpLog",
        "schemes": [
          "uplog"
        ]
      }
    ],
    "afterSign": "scripts/after-sign.cjs"
  }
}
